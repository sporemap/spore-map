{
  "name": "spore-map",
  "version": "0.1.0",
  "description": "The Spore ecosystem map: a d3-force bubble map of every pump.fun custom pair, as a page and as a React component.",
  "license": "MIT",
  "author": "Spore <team@sporepad.com>",
  "homepage": "https://sporepad.com/map",
  "keywords": ["pump.fun", "solana", "bubble-map", "d3-force", "canvas", "react", "spore"],
  "type": "module",
  "private": false,
  "files": ["dist-lib", "README.md", "LICENSE"],
  "main": "./dist-lib/spore-map.js",
  "module": "./dist-lib/spore-map.js",
  "types": "./dist-lib/types/lib.d.ts",
  "exports": {
    ".": { "types": "./dist-lib/types/lib.d.ts", "import": "./dist-lib/spore-map.js" },
    "./style.css": "./dist-lib/spore-map.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "d3": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": { "node": ">=20" }
}
